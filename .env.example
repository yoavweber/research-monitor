APP_ENV=dev
HTTP_PORT=8080
SQLITE_PATH=./data/app.db
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ARXIV_BASE_URL=https://export.arxiv.org/api/query
ARXIV_CATEGORIES=cs.LG,q-fin.ST
ARXIV_MAX_RESULTS=100
# Filesystem root where the PDF store materializes downloaded PDFs.
PDF_STORE_ROOT=data/pdfs
# HMAC signing key for JWT auth. Required, no default, minimum 32 bytes.
# Generate one with: openssl rand -base64 32
AUTH_JWT_SECRET=change-me-to-a-random-32-byte-or-longer-secret
# Optional; defaults to 24h.
AUTH_JWT_TTL=24h
